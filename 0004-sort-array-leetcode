class Solution
{
public:
    void mergeSingleLiat(vector<int>&nums, int low, int mid, int high)
    {
        int i = low;
        int k = low;
        int j = mid + 1;
        int a[high + 1];
        while (i <= mid && j <= high)
        {
            if (nums[i] < nums[j])
            {
                a[k++] = nums[i++];
            }
            else
            {
                a[k++] = nums[j++];
            }
        }
        while (i <= mid)
            a[k++] = nums[i++];
        while (j <= high)
            a[k++] = nums[j++];
        for (i = low; i <= high; i++)
            nums[i] = a[i];
    }

    void recursiveMerge(vector<int>& nums, int low, int high)
    {
        int mid;
        if (low < high)
        {
            mid = (low + high) / 2;
            recursiveMerge(nums, low, mid);
            recursiveMerge(nums, mid + 1, high);
            mergeSingleLiat(nums, low, mid, high);
        }
    }

    vector<int> sortArray(vector<int>& nums)
    {
         recursiveMerge(nums, 0, nums.size() - 1);
        return nums;
    }
};
